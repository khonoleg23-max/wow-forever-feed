{{$CL := sdict "war" "Воин" "pal" "Паладин" "hun" "Охотник" "rog" "Разбойник" "pri" "Жрец" "sha" "Шаман" "mag" "Маг" "wlk" "Чернокнижник" "dru" "Друид"}}{{$EM := sdict "war" "⚔️" "pal" "🔨" "hun" "🏹" "rog" "🗡" "pri" "✨" "sha" "⚡" "mag" "❄️" "wlk" "💀" "dru" "🐾"}}{{$out := ""}}{{range dbGetPattern .User.ID "kq-%" 10 0}}{{$k := reReplace `^kq-` .Key ""}}{{$r := split (print .Value) "-"}}{{$nd := 0}}{{if ne (index $r 2) "x"}}{{$nd = len (split (index $r 2) ".")}}{{end}}{{$nz := 0}}{{if ne (index $r 3) "x"}}{{$nz = len (split (index $r 3) ".")}}{{end}}{{$out = print $out ($EM.Get $k) " **" ($CL.Get $k) "** — " (index $r 0) "–" (index $r 1) " ур. · подземелий: " $nd " · зон: " $nz "\n`/kadgar KQ1:" $k ":" (index $r 0) ":" (index $r 1) ":" (index $r 2) ":" (index $r 3) "`\n"}}{{end}}{{if not $out}}{{$out = "Пока пусто. Напиши «Кадгар, что мне делать дальше?» и пройди опрос — я запомню героя."}}{{end}}{{sendMessage nil (complexMessage "reply" .Message.ID "embed" (cembed "author" (sdict "name" "Кадгар, хранитель знаний Кирин-Тора" "icon_url" "https://wow.zamimg.com/images/wow/icons/large/quest_khadgar.jpg") "color" 6933744 "title" (print "🛡 Герои " .User.Username) "description" $out "footer" (sdict "text" "Код вставь в чат игры героем этого класса — аддон KadgarGuide учтёт прогресс")))}}
