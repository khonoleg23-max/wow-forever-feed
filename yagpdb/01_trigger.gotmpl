{{$b := cbutton "label" "Пройти опрос" "custom_id" "kq-s" "emoji" (sdict "name" "📜")}}{{sendMessage nil (complexMessage "reply" .Message.ID "embed" (cembed "author" (sdict "name" "Кадгар, хранитель знаний Кирин-Тора" "icon_url" "https://wow.zamimg.com/images/wow/icons/large/quest_khadgar.jpg") "color" 6933744 "title" "🧭 Куда держать путь, герой?" "description" "Ответь на пару вопросов — уровень, пройденные подземелья и зоны — и я подскажу, куда идти дальше, какие таланты брать и что выучить у тренера.\n\nКласс я узнаю по твоей роли на сервере. Ответы видишь только ты." "footer" (sdict "text" "WoW Forever · Альянс · быстрый вариант: !ур 23")) "buttons" $b)}}
