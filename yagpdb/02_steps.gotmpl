{{$p := split (reReplace `^.*?kq-` .CustomID "") "-"}}{{$st := index $p 0}}{{$CL := sdict "war" "Воин" "pal" "Паладин" "hun" "Охотник" "rog" "Разбойник" "pri" "Жрец" "sha" "Шаман" "mag" "Маг" "wlk" "Чернокнижник" "dru" "Друид"}}{{$EM := sdict "war" "⚔️" "pal" "🔨" "hun" "🏹" "rog" "🗡" "pri" "✨" "sha" "⚡" "mag" "❄️" "wlk" "💀" "dru" "🐾"}}{{$RID := sdict "war" 1570687511083098132 "pal" 1570687683209207839 "hun" 1570687696161214556 "rog" 1570687983907246240 "pri" 1570688060490776628 "sha" 1570688087007428700 "mag" 1570688160621400074 "wlk" 1570688187091656755 "dru" 1570688266028711936}}{{$cls := ""}}{{$lo := 0}}{{$hi := 0}}{{$dl := "x"}}{{$first := eq $st "s"}}{{if eq $st "s"}}{{$st = "C"}}{{else if eq $st "c"}}{{$cls = index .Values 0}}{{$st = "L"}}{{else if eq $st "l"}}{{$cls = index $p 1}}{{$r := split (index .Values 0) "-"}}{{$lo = toInt (index $r 0)}}{{$hi = toInt (index $r 1)}}{{$st = "D"}}{{else if eq $st "d"}}{{$cls = index $p 1}}{{$lo = toInt (index $p 2)}}{{$hi = toInt (index $p 3)}}{{$v := cslice}}{{range .Values}}{{if ne . "x"}}{{$v = $v.Append .}}{{end}}{{end}}{{if $v}}{{$dl = joinStr "." $v.StringSlice}}{{end}}{{$st = "Z"}}{{end}}{{$sav := "0-0-x-x"}}{{if $cls}}{{with dbGet .User.ID (print "kq-" $cls)}}{{$sav = print .Value}}{{end}}{{end}}{{$sp := split $sav "-"}}{{$SD := split (index $sp 2) "."}}{{$SZ := split (index $sp 3) "."}}{{$SL := print (index $sp 0) "-" (index $sp 1)}}{{$txt := ""}}{{$menu := ""}}{{if eq $st "C"}}{{$mine := ""}}{{range $k, $v := $RID}}{{if hasRoleID $v}}{{$mine = $k}}{{end}}{{end}}{{$sv := sdict}}{{range dbGetPattern .User.ID "kq-%" 10 0}}{{$sv.Set (reReplace `^kq-` .Key "") (print .Value)}}{{end}}{{$o := cslice}}{{$top := ""}}{{range split "war pal hun rog pri sha mag wlk dru" " "}}{{$k := .}}{{$d := ""}}{{if eq $k $mine}}{{$d = "твоя роль на сервере"}}{{end}}{{with $sv.Get $k}}{{$r := split . "-"}}{{if $d}}{{$d = print $d " · "}}{{end}}{{$d = print $d "📌 сохранён: " (index $r 0) "–" (index $r 1) " ур."}}{{end}}{{$x := sdict "label" ($CL.Get $k) "value" $k "emoji" (sdict "name" ($EM.Get $k))}}{{if $d}}{{$x.Set "description" $d}}{{end}}{{if eq $k $mine}}{{$top = $x}}{{else}}{{$o = $o.Append $x}}{{end}}{{end}}{{if $top}}{{$o = (cslice $top).AppendSlice $o}}{{end}}{{$txt = "⚔️ Каким героем играешь сейчас? У каждого твинка — свой прогресс, я его запомню."}}{{$menu = cmenu "type" "text" "custom_id" "kq-c" "placeholder" "Выбери класс героя" "options" $o}}{{else if eq $st "L"}}{{$txt = print "Герой: **" ($EM.Get $cls) " " ($CL.Get $cls) "**. 📈 Какого он уровня?"}}{{if ne $SL "0-0"}}{{$txt = print $txt " (в прошлый раз: " $SL ")"}}{{end}}{{$o := cslice}}{{range split "1-9;10-14;15-19;20-24;25-29;30-34;35-39;40-44;45-49;50-54;55-59;60-60" ";"}}{{$r := split . "-"}}{{$lab := print (index $r 0) "–" (index $r 1)}}{{if eq (index $r 0) (index $r 1)}}{{$lab = index $r 0}}{{end}}{{$x := sdict "label" (print $lab " уровень") "value" .}}{{if eq . $SL}}{{$x.Set "emoji" (sdict "name" "📌")}}{{$x.Set "description" "как в прошлый раз"}}{{end}}{{$o = $o.Append $x}}{{end}}{{$menu = cmenu "type" "text" "custom_id" (print "kq-l-" $cls) "placeholder" "Выбери уровень" "options" $o}}{{else if eq $st "D"}}{{$o := cslice (sdict "label" "Ничего нового" "value" "x" "emoji" (sdict "name" "➖"))}}{{range split `1|Чертоги Танов ✨|13|18|под Стальгорном;2|Руины Лордерона ✨|15|20|Тирисфальские леса, далеко;3|Пещеры Стенаний|15|25|Степи;4|Мёртвые копи|18|23|Западный Край, Луноречье;5|Крепость Тёмного Клыка|22|30|Серебряный бор;6|Тюрьма|22|30|Штормград;7|Раскопки ✨|24|29|Болотина;8|Непроглядная Пучина|24|32|Ясеневый лес;9|Даларан ✨|28|33|Альтеракские горы;10|Монастырь: Кладбище|28|38|Тирисфальские леса;11|Гномреган|29|38|Дун Морог;12|Монастырь: Библиотека|29|39|Тирисфальские леса;13|Лабиринты Иглошкурых|30|40|Степи;14|Монастырь: Оружейная|32|42|Тирисфальские леса;15|Затонувший город ✨|35|40|под водой у Тернистой долины;16|Монастырь: Собор|35|45|Тирисфальские леса;17|Крепость Крол'док ✨|40|45|Riverglades;18|Курганы Иглошкурых|40|50|Степи;19|Ульдаман|42|52|Бесплодные земли;20|Зул'Фаррак|44|54|Танарис;21|Мародон|45|57|Пустоши;22|Тюрьма острова Алькац ✨|48|53|Пылевые топи;23|Затонувший храм|50|60|Болото Печали;24|Глубины Чёрной горы|52|60|Чёрная гора;25|Blackmaw Hold ✨|55|60|—;26|Нижний Пик Чёрной горы|55|60|Чёрная гора;27|Shaper's Terrace ✨|58|60|—;28|Верхний Пик Чёрной горы|58|60|Чёрная гора;29|Забытый город|58|60|Фералас;30|Некроситет|58|60|Западные Чумные земли;31|Стратхольм|58|60|Восточные Чумные земли` ";"}}{{$f := split . "|"}}{{$a := toInt (index $f 2)}}{{$b := toInt (index $f 3)}}{{if and (le $a (add $hi 2)) (ge $b (sub $lo 4))}}{{$x := sdict "label" (index $f 1) "value" (index $f 0) "description" (print $a "–" $b " · " (index $f 4))}}{{if in $SD (index $f 0)}}{{$x.Set "emoji" (sdict "name" "✅")}}{{$x.Set "description" (print "уже отмечено · " $a "–" $b)}}{{end}}{{$o = $o.Append $x}}{{end}}{{end}}{{if eq (len $o) 1}}{{$st = "Z"}}{{else}}{{$txt = print "Уровень **" $lo "–" $hi "**. 🏰 Какие подземелья ты уже прошёл? ✅ — я уже помню, отметь новые."}}{{$menu = cmenu "type" "text" "custom_id" (print "kq-d-" $cls "-" $lo "-" $hi) "placeholder" "Отметь пройденные" "min_values" 1 "max_values" (len $o) "options" $o}}{{end}}{{end}}{{if eq $st "Z"}}{{$SD = $SZ}}{{$o := cslice (sdict "label" "Ничего нового" "value" "x" "emoji" (sdict "name" "➖"))}}{{range split `1|Элвиннский лес|1|10|Североземье → Златоземье;2|Дун Морог|1|10|Холодная Долина → Каранос;3|Тельдрассил|1|10|Тень Леса → Доланаар;4|Zephras Isle|1|12|стартовая зона скайборнов;5|Западный Край|10|20|Сторожевой холм;6|Лок Модан|10|20|Телсамар;7|Тёмные берега|11|20|Аубердин;8|Красногорье|15|25|Озёрный край;9|Когтистые горы|15|27|Каменный Коготь;10|Сумеречный лес|20|30|Темнолесье;11|Болотина|20|30|Менетильская гавань;12|Ясеневый лес|20|30|Астранаар;13|Тысяча Игл|25|35|Миражи (гоблины);14|Предгорья Хилсбрада|28|34|Южнобережье;15|Нагорье Арати|30|40|Опорный пункт;16|Альтеракские горы|30|40|у входа в Даларан;17|Пустоши|30|40|Застава Нижел;18|Тернистая долина|30|45|лагерь Ребрака, Пиратская Бухта;19|Riverglades|36|44|Farholde Keep на юге;20|Пылевые топи|35|45|Терамор;21|Бесплодные земли|35|45|лагерь Котел;22|Болото Печали|35|45|у Каменора;23|Танарис|40|50|Прибамбасск;24|Фералас|40|50|Крепость Оперённой Луны;25|Shen'Dralas|40|50|между Мулгором и Пустошами;26|Тлеющее ущелье|43|50|Торий-Пойнт;27|Внутренние земли|45|50|Заоблачный пик;28|Выжженные земли|45|55|Страж Неспящих;29|Азшара|45|55|Талрендисова застава;30|Кратер Ун'Горо|48|55|Укрытие Маршала;31|Оскверненный лес|48|55|Таловая поляна;32|Пылающие степи|50|58|Застава Моргана;33|Западные Чумные земли|51|58|Лагерь Охранного Холма;34|Восточные Чумные земли|53|60|Часовня Последней Надежды;35|Зимние Ключи|55|60|Круговзор;36|Силитус|55|60|Крепость Кенария;37|Хиджал|60|60|новая зона 60 уровня` ";"}}{{$f := split . "|"}}{{$a := toInt (index $f 2)}}{{$b := toInt (index $f 3)}}{{if and (le $a (add $hi 1)) (ge $b (sub $lo 5))}}{{$x := sdict "label" (index $f 1) "value" (index $f 0) "description" (print $a "–" $b " · " (index $f 4))}}{{if in $SD (index $f 0)}}{{$x.Set "emoji" (sdict "name" "✅")}}{{$x.Set "description" (print "уже отмечено · " $a "–" $b)}}{{end}}{{$o = $o.Append $x}}{{end}}{{end}}{{$txt = "🗺 В каких зонах ты уже выполнил задания? ✅ — я уже помню, отметь новые."}}{{$menu = cmenu "type" "text" "custom_id" (print "kq-z-" $cls "-" $lo "-" $hi "-" $dl) "placeholder" "Отметь зоны" "min_values" 1 "max_values" (len $o) "options" $o}}{{end}}{{if $first}}{{sendResponse nil (complexMessage "content" $txt "menus" $menu "ephemeral" true)}}{{else}}{{updateMessage (complexMessageEdit "content" $txt "menus" $menu)}}{{end}}
