{{$p := split (reReplace `^.*?kq-z-` .CustomID "") "-"}}{{$lo := toInt (index $p 1)}}{{$hi := toInt (index $p 2)}}{{$dd := split (index $p 3) "."}}{{$zd := .Values}}{{$Z := `1|Элвиннский лес|1|10|Североземье → Златоземье;2|Дун Морог|1|10|Холодная Долина → Каранос;3|Тельдрассил|1|10|Тень Леса → Доланаар;4|Zephras Isle|1|12|стартовая зона скайборнов;5|Западный Край|10|20|Сторожевой холм;6|Лок Модан|10|20|Телсамар;7|Тёмные берега|11|20|Аубердин;8|Красногорье|15|25|Озёрный край;9|Когтистые горы|15|27|Каменный Коготь;10|Сумеречный лес|20|30|Темнолесье;11|Болотина|20|30|Менетильская гавань;12|Ясеневый лес|20|30|Астранаар;13|Тысяча Игл|25|35|Миражи (гоблины);14|Предгорья Хилсбрада|28|34|Южнобережье;15|Нагорье Арати|30|40|Опорный пункт;16|Альтеракские горы|30|40|у входа в Даларан;17|Пустоши|30|40|Застава Нижел;18|Тернистая долина|30|45|лагерь Ребрака, Пиратская Бухта;19|Riverglades|36|44|Farholde Keep на юге;20|Пылевые топи|35|45|Терамор;21|Бесплодные земли|35|45|лагерь Котел;22|Болото Печали|35|45|у Каменора;23|Танарис|40|50|Прибамбасск;24|Фералас|40|50|Крепость Оперённой Луны;25|Shen'Dralas|40|50|между Мулгором и Пустошами;26|Тлеющее ущелье|43|50|Торий-Пойнт;27|Внутренние земли|45|50|Заоблачный пик;28|Выжженные земли|45|55|Страж Неспящих;29|Азшара|45|55|Талрендисова застава;30|Кратер Ун'Горо|48|55|Укрытие Маршала;31|Оскверненный лес|48|55|Таловая поляна;32|Пылающие степи|50|58|Застава Моргана;33|Западные Чумные земли|51|58|Лагерь Охранного Холма;34|Восточные Чумные земли|53|60|Часовня Последней Надежды;35|Зимние Ключи|55|60|Круговзор;36|Силитус|55|60|Крепость Кенария;37|Хиджал|60|60|новая зона 60 уровня`}}{{$D := `1|Чертоги Танов ✨|13|18|под Стальгорном;2|Руины Лордерона ✨|15|20|Тирисфальские леса, далеко;3|Пещеры Стенаний|15|25|Степи;4|Мёртвые копи|18|23|Западный Край, Луноречье;5|Крепость Тёмного Клыка|22|30|Серебряный бор;6|Тюрьма|22|30|Штормград;7|Раскопки ✨|24|29|Болотина;8|Непроглядная Пучина|24|32|Ясеневый лес;9|Даларан ✨|28|33|Альтеракские горы;10|Монастырь: Кладбище|28|38|Тирисфальские леса;11|Гномреган|29|38|Дун Морог;12|Монастырь: Библиотека|29|39|Тирисфальские леса;13|Лабиринты Иглошкурых|30|40|Степи;14|Монастырь: Оружейная|32|42|Тирисфальские леса;15|Затонувший город ✨|35|40|под водой у Тернистой долины;16|Монастырь: Собор|35|45|Тирисфальские леса;17|Крепость Крол'док ✨|40|45|Riverglades;18|Курганы Иглошкурых|40|50|Степи;19|Ульдаман|42|52|Бесплодные земли;20|Зул'Фаррак|44|54|Танарис;21|Мародон|45|57|Пустоши;22|Тюрьма острова Алькац ✨|48|53|Пылевые топи;23|Затонувший храм|50|60|Болото Печали;24|Глубины Чёрной горы|52|60|Чёрная гора;25|Blackmaw Hold ✨|55|60|—;26|Нижний Пик Чёрной горы|55|60|Чёрная гора;27|Shaper's Terrace ✨|58|60|—;28|Верхний Пик Чёрной горы|58|60|Чёрная гора;29|Забытый город|58|60|Фералас;30|Некроситет|58|60|Западные Чумные земли;31|Стратхольм|58|60|Восточные Чумные земли`}}{{$out := ""}}{{$n := 0}}{{range split $Z ";"}}{{$f := split . "|"}}{{$a := toInt (index $f 2)}}{{$b := toInt (index $f 3)}}{{if and (le $a $hi) (ge $b $lo) (not (in $zd (index $f 0))) (lt $n 4)}}{{$out = print $out "• **" (index $f 1) "** (" $a "–" $b ") — " (index $f 4) "\n"}}{{$n = add $n 1}}{{end}}{{end}}{{$zones := $out}}{{if not $zones}}{{$out := ""}}{{$n := 0}}{{range split $Z ";"}}{{$f := split . "|"}}{{$a := toInt (index $f 2)}}{{$b := toInt (index $f 3)}}{{if and (le $a (add $hi 8)) (ge $b (add $hi 1)) (not (in $zd (index $f 0))) (lt $n 4)}}{{$out = print $out "• **" (index $f 1) "** (" $a "–" $b ") — " (index $f 4) "\n"}}{{$n = add $n 1}}{{end}}{{end}}{{$zones = print "Здесь ты всё прошёл — пора дальше:\n" $out}}{{end}}{{if not $zones}}{{$zones = "Ты прошёл все зоны своего уровня — бери подземелья и задания-наводки!"}}{{end}}{{$out := ""}}{{$n := 0}}{{range split $D ";"}}{{$f := split . "|"}}{{$a := toInt (index $f 2)}}{{$b := toInt (index $f 3)}}{{if and (le $a $hi) (ge $b $lo) (not (in $dd (index $f 0))) (lt $n 4)}}{{$out = print $out "• **" (index $f 1) "** (" $a "–" $b ") — " (index $f 4) "\n"}}{{$n = add $n 1}}{{end}}{{end}}{{$dun := $out}}{{if not $dun}}{{$out := ""}}{{$n := 0}}{{range split $D ";"}}{{$f := split . "|"}}{{$a := toInt (index $f 2)}}{{$b := toInt (index $f 3)}}{{if and (le $a (add $hi 6)) (ge $b (add $hi 1)) (not (in $dd (index $f 0))) (lt $n 4)}}{{$out = print $out "• **" (index $f 1) "** (" $a "–" $b ") — " (index $f 4) "\n"}}{{$n = add $n 1}}{{end}}{{end}}{{$dun = $out}}{{if $dun}}{{$dun = print "Скоро откроются:\n" $dun}}{{end}}{{end}}{{if lt $hi 13}}{{$dun = "Первые подземелья — с 13 уровня (✨ Чертоги Танов под Стальгорном)."}}{{else if not $dun}}{{$dun = "Подходящие подземелья пройдены — отличная работа!"}}{{end}}{{$tal := ""}}{{$next := ""}}{{range split `10|10–14: **Benediction** 5/5 — дешевле мгновенные заклинания.§15|15–16: **Improved Judgement** 2/2, 17–19: **Sanctified Judgement** 3/3 — Правосудие даёт ману.§20|20: **Печать повиновения** (Seal of Command), дальше **Pursuit of Justice** — быстрее бегаешь.§40|40: **Unsealed Wrath** — последний талант ветки; остаток в Свет и Защиту (**Improved Seals**, мана).` "§"}}{{$f := split . "|"}}{{if le (toInt (index $f 0)) $hi}}{{$tal = index $f 1}}{{else if not $next}}{{$next = print "С " (index $f 0) " ур.: " (index $f 1)}}{{end}}{{end}}{{if lt $hi 10}}{{$tal = "Таланты откроются на 10 уровне."}}{{end}}{{if $next}}{{$tal = print $tal "\n\n**Дальше.** " $next}}{{end}}{{$have := cslice}}{{$soon := cslice}}{{range split `1|Печать праведности;1|Свет небес;4|Благословение могущества;4|Правосудие;6|Holy Strike;6|Печать воина Света;8|Молот правосудия;16|Аура воздаяния;18|Благословение свободы;20|Освящение;20|Печать повиновения;20|Вспышка Света;34|Божественный щит;42|Очищение;44|Молот гнева` ";"}}{{$f := split . "|"}}{{$a := toInt (index $f 0)}}{{if le $a $hi}}{{$have = $have.Append (index $f 1)}}{{else if le $a (add $hi 6)}}{{$soon = $soon.Append (print (index $f 1) " (" $a ")")}}{{end}}{{end}}{{$sk := print "**Должно быть выучено** (и новые ранги у тренера каждые 2 уровня): " (joinStr ", " $have.StringSlice)}}{{if $soon}}{{$sk = print $sk "\n**Скоро:** " (joinStr ", " $soon.StringSlice)}}{{end}}{{$sk = print $sk "\n**Можно сэкономить:** " `Печать справедливости, Аура сосредоточенности, Изгнание нежити, Гнев небес — пропусти. Аура благочестия и Возложение рук — только 1-й ранг; Экзорцизм — если бьёшь нежить/демонов.`}}{{sendResponse nil (complexMessage "ephemeral" true "embed" (cembed "author" (sdict "name" "Кадгар, хранитель знаний Кирин-Тора" "icon_url" "https://wow.zamimg.com/images/wow/icons/large/quest_khadgar.jpg") "color" 6933744 "title" (print "🔨 Паладин, " $lo "–" $hi " уровень — твой путь") "fields" (cslice (sdict "name" "🗺 Куда идти" "value" $zones) (sdict "name" "🏰 Подземелья" "value" $dun) (sdict "name" "🌟 Таланты · Воздаяние (Retribution)" "value" $tal) (sdict "name" "📖 Тренер" "value" $sk)) "description" "[Полный гайд по классу на Wowhead](https://www.wowhead.com/forever/guide/classes/paladin/retribution/dps-leveling-tips) · маршрут — в #📖-библиотека-даларана" "footer" (sdict "text" "✨ — новое в WoW Forever · по гайдам Wowhead")))}}
