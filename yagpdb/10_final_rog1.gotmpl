{{$p := split (reReplace `^.*?kq-z-` .CustomID "") "-"}}{{$lo := toInt (index $p 1)}}{{$hi := toInt (index $p 2)}}{{$key := "kq-rog"}}{{$sav := "0-0-x-x"}}{{with dbGet .User.ID $key}}{{$sav = print .Value}}{{end}}{{$sp := split $sav "-"}}{{$dd := cslice}}{{range (split (index $p 3) ".")}}{{if ne . "x"}}{{$dd = $dd.Append .}}{{end}}{{end}}{{range split (index $sp 2) "."}}{{if and (ne . "x") (not (in $dd .))}}{{$dd = $dd.Append .}}{{end}}{{end}}{{$zd := cslice}}{{range .Values}}{{if ne . "x"}}{{$zd = $zd.Append .}}{{end}}{{end}}{{range split (index $sp 3) "."}}{{if and (ne . "x") (not (in $zd .))}}{{$zd = $zd.Append .}}{{end}}{{end}}{{$dj := "x"}}{{if $dd}}{{$dj = joinStr "." $dd.StringSlice}}{{end}}{{$zj := "x"}}{{if $zd}}{{$zj = joinStr "." $zd.StringSlice}}{{end}}{{dbSet .User.ID $key (print $lo "-" $hi "-" $dj "-" $zj "-1")}}{{$code := print "/kadgar KQ1:rog:" $lo ":" $hi ":" $dj ":" $zj ":1"}}{{$Z := `1|Элвиннский лес|1|10|Североземье → Златоземье;2|Дун Морог|1|10|Холодная Долина → Каранос;3|Тельдрассил|1|10|Тень Леса → Доланаар;4|Остров Зефрис|1|12|стартовая зона скайборнов;5|Западный Край|10|20|Сторожевой холм;6|Лок Модан|10|20|Телсамар;7|Тёмные берега|11|20|Аубердин;8|Красногорье|15|25|Озёрный край;9|Когтистые горы|15|27|Каменный Коготь;10|Сумеречный лес|20|30|Темнолесье;11|Болотина|20|30|Менетильская гавань;12|Ясеневый лес|20|30|Астранаар;13|Тысяча Игл|25|35|Миражи (гоблины);14|Предгорья Хилсбрада|28|34|Южнобережье;15|Нагорье Арати|30|40|Опорный пункт;16|Альтеракские горы|30|40|у входа в Даларан;17|Пустоши|30|40|Застава Нижел;18|Тернистая долина|30|45|лагерь Ребрака, Пиратская Бухта;19|Лесоречье|36|44|крепость на юге зоны;20|Пылевые топи|35|45|Терамор;21|Бесплодные земли|35|45|лагерь Котел;22|Болото Печали|35|45|у Каменора;23|Танарис|40|50|Прибамбасск;24|Фералас|40|50|Крепость Оперённой Луны;25|Шен'дралас|40|50|между Мулгором и Пустошами;26|Тлеющее ущелье|43|50|Торий-Пойнт;27|Внутренние земли|45|50|Заоблачный пик;28|Выжженные земли|45|55|Страж Неспящих;29|Азшара|45|55|Талрендисова застава;30|Кратер Ун'Горо|48|55|Укрытие Маршала;31|Оскверненный лес|48|55|Таловая поляна;32|Пылающие степи|50|58|Застава Моргана;33|Западные Чумные земли|51|58|Лагерь Охранного Холма;34|Восточные Чумные земли|53|60|Часовня Последней Надежды;35|Зимние Ключи|55|60|Круговзор;36|Силитус|55|60|Крепость Кенария;37|Гора Хиджал|60|60|новая зона 60 уровня`}}{{$D := `1|Чертоги танов ✨|13|18|под Стальгорном;2|Руины Лордерона ✨|15|20|Тирисфальские леса, далеко;3|Пещеры Стенаний|15|25|Степи;4|Мёртвые копи|18|23|Западный Край, Луноречье;5|Крепость Тёмного Клыка|22|30|Серебряный бор;6|Тюрьма|22|30|Штормград;7|Раскопки: Болотина ✨|24|29|Болотина;8|Непроглядная Пучина|24|32|Ясеневый лес;9|Даларан ✨|28|33|Альтеракские горы;10|Монастырь: Кладбище|28|38|Тирисфальские леса;11|Гномреган|29|38|Дун Морог;12|Монастырь: Библиотека|29|39|Тирисфальские леса;13|Лабиринты Иглошкурых|30|40|Степи;14|Монастырь: Оружейная|32|42|Тирисфальские леса;15|Затонувший город ✨|35|40|под водой у Тернистой долины;16|Монастырь: Собор|35|45|Тирисфальские леса;17|Крепость Крол'док ✨|40|45|Лесоречье;18|Курганы Иглошкурых|40|50|Степи;19|Ульдаман|42|52|Бесплодные земли;20|Зул'Фаррак|44|54|Танарис;21|Мародон|45|57|Пустоши;22|Тюрьма Алькац ✨|48|53|Пылевые топи;23|Затонувший храм|50|60|Болото Печали;24|Глубины Чёрной горы|52|60|Чёрная гора;25|Крепость Черночревов ✨|55|60|—;26|Нижний Пик Чёрной горы|55|60|Чёрная гора;27|Терраса Создателя ✨|58|60|—;28|Верхний Пик Чёрной горы|58|60|Чёрная гора;29|Забытый город|58|60|Фералас;30|Некроситет|58|60|Западные Чумные земли;31|Стратхольм|58|60|Восточные Чумные земли`}}{{$out := ""}}{{$n := 0}}{{range split $Z ";"}}{{$f := split . "|"}}{{$a := toInt (index $f 2)}}{{$b := toInt (index $f 3)}}{{if and (le $a $hi) (ge $b (add $lo 2)) (not (in $zd (index $f 0))) (lt $n 4)}}{{$out = print $out "• **" (index $f 1) "** (" $a "–" $b ") — " (index $f 4) "\n"}}{{$n = add $n 1}}{{end}}{{end}}{{$zones := $out}}{{if not $zones}}{{$out := ""}}{{$n := 0}}{{range split $Z ";"}}{{$f := split . "|"}}{{$a := toInt (index $f 2)}}{{$b := toInt (index $f 3)}}{{if and (le $a (add $hi 8)) (ge $b (add (add $hi 1) 2)) (not (in $zd (index $f 0))) (lt $n 4)}}{{$out = print $out "• **" (index $f 1) "** (" $a "–" $b ") — " (index $f 4) "\n"}}{{$n = add $n 1}}{{end}}{{end}}{{$zones = print "Здесь ты всё прошёл — пора дальше:\n" $out}}{{end}}{{if not $zones}}{{$zones = "Ты прошёл все зоны своего уровня — бери подземелья и задания-наводки!"}}{{end}}{{$out := ""}}{{$n := 0}}{{range split $D ";"}}{{$f := split . "|"}}{{$a := toInt (index $f 2)}}{{$b := toInt (index $f 3)}}{{if and (le $a $hi) (ge $b (add $lo 2)) (not (in $dd (index $f 0))) (lt $n 4)}}{{$out = print $out "• **" (index $f 1) "** (" $a "–" $b ") — " (index $f 4) "\n"}}{{$n = add $n 1}}{{end}}{{end}}{{$dun := $out}}{{if not $dun}}{{$out := ""}}{{$n := 0}}{{range split $D ";"}}{{$f := split . "|"}}{{$a := toInt (index $f 2)}}{{$b := toInt (index $f 3)}}{{if and (le $a (add $hi 6)) (ge $b (add (add $hi 1) 2)) (not (in $dd (index $f 0))) (lt $n 4)}}{{$out = print $out "• **" (index $f 1) "** (" $a "–" $b ") — " (index $f 4) "\n"}}{{$n = add $n 1}}{{end}}{{end}}{{$dun = $out}}{{if $dun}}{{$dun = print "Скоро откроются:\n" $dun}}{{end}}{{end}}{{if lt $hi 13}}{{$dun = "Первые подземелья — с 13 уровня (✨ Чертоги танов под Стальгорном)."}}{{else if not $dun}}{{$dun = "Подходящие подземелья пройдены — отличная работа!"}}{{end}}{{$tal := ""}}{{$next := ""}}{{range split `10|**Улучшенный парализующий удар** 3/3, **Беспощадные атаки** 2/2, **Злоба** 5/5, **Жестокость** 3/3, **Улучшенное ослабление доспеха** 2/2, **Улучшенная мясорубка** 3/3.§20|**Неутомимость** 2/2, **Брызги крови**, **Смертоносность** 2/2, **Тлетворные яды** 5/5, **Хладнокровие**, **Улучшенные яды** 5/5.§30|**Неослабевающие удары** 5/5, **Яд**, **Улучшенный удар по почкам** 2/2, **Печать судьбы** 3/3.§40|**Расправа**.` "§"}}{{$f := split . "|"}}{{if le (toInt (index $f 0)) $hi}}{{$tal = index $f 1}}{{else if not $next}}{{$next = print "С " (index $f 0) " ур.: " (index $f 1)}}{{end}}{{end}}{{if lt $hi 10}}{{$tal = "Таланты откроются на 10 уровне."}}{{end}}{{if $next}}{{$tal = print $tal "\n\n**Дальше.** " $next}}{{end}}{{$have := cslice}}{{$soon := cslice}}{{range split `1|Коварный удар;1|Незаметность;1|Потрошение;8|Ускользание;10|Мясорубка;10|Спринт;12|Пинок;22|Исчезновение;24|Подлый удар;34|Ослепление` ";"}}{{$f := split . "|"}}{{$a := toInt (index $f 0)}}{{if le $a $hi}}{{$have = $have.Append (index $f 1)}}{{else if le $a (add $hi 6)}}{{$soon = $soon.Append (print (index $f 1) " (" $a ")")}}{{end}}{{end}}{{$sk := print "**Должно быть выучено** (и новые ранги у тренера каждые 2 уровня): " (joinStr ", " $have.StringSlice)}}{{if $soon}}{{$sk = print $sk "\n**Скоро:** " (joinStr ", " $soon.StringSlice)}}{{end}}{{$sk = print $sk "\n**Можно сэкономить:** " `Удар в спину, Парализующий удар, Гаррота, Ложный выпад, Внезапный удар, Рваная рана, Подлый трюк, Удар по почкам — по желанию.`}}{{sendResponse nil (complexMessage "ephemeral" true "embed" (cembed "author" (sdict "name" "Кадгар, хранитель знаний Кирин-Тора" "icon_url" "https://wow.zamimg.com/images/wow/icons/large/quest_khadgar.jpg") "color" 6933744 "title" (print "🗡 Разбойник · Ликвидация, " $lo "–" $hi " уровень — твой путь") "fields" (cslice (sdict "name" "🗺 Куда идти" "value" $zones) (sdict "name" "🏰 Подземелья" "value" $dun) (sdict "name" "🌟 Таланты · Ликвидация" "value" $tal) (sdict "name" "📖 Тренер" "value" $sk) (sdict "name" "🧩 Для аддона KadgarGuide" "value" (print "Вставь в чат игры этим героем:\n```" $code "```"))) "description" "[Полный гайд по классу на Wowhead](https://www.wowhead.com/forever/guide/classes/rogue/combat/dps-leveling-tips) · маршрут — в #📖-библиотека-даларана" "footer" (sdict "text" "💾 Герой сохранён — !герои покажет всех · ✨ — новое в WoW Forever")))}}
